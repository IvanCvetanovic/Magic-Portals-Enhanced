{
  "_about": [
    "Whether each level's door can be reached in the port: tools/parity/reachability.py",
    "over the converted levels (out/levels), with the port's rules read from data/ and",
    "game/data/. Derived by the tool, never hand-edited: rerun it with --check after any",
    "change to the converter, the levels or a mechanism that opens a wall, and with",
    "--write only in a step that says why a verdict moved. The node names are the",
    "converter's; nothing of the original's files is here."
  ],
  "_breakers": {
    "stone": "every breakable on a level that holds a demolisher: a rolling stone, a launcher that throws one, or the beholder's rocks (game/sim/Demolish.cpp:87-101 State::Tick, :185-191 the stones, Game.cpp:309 a thrown one, Game.cpp:818 the boss's rock)",
    "barrel": "a flagged breakable whose entity demolish.json blast.entities lists, on a level with a barrel (metadata/explosive) and fire to set one off: a fire agent, a carranca or a fire diamond (game/sim/Fire.cpp:44-73 the blast's grab, Game.cpp:351-352 Demolish's Grab and Destroyed on the blast's tick, Demolish.cpp:129-156)",
    "torch": "the torch's light wall (torch.json wall.entity_name) on a level with a torch (game/sim/Game.cpp:687-691, Demolish.cpp:103-115 Break)",
    "dark_dragon": "the dark dragon's wall (darkdragon.json summon.wall, the last node of that name) on a level with its spawn (game/sim/Game.cpp:718-722, DarkDragon.cpp:797-799)",
    "fire": "a crate that fades when it burns (fire.json burn.fade_names), on a level with fire: a fire agent, a carranca or a fire diamond (game/sim/Fire.cpp:206-210 a fire agent, Game.cpp:415-420 a fireball, Game.cpp:524 a fire diamond's; Fire.cpp:241 the fade)"
  },
