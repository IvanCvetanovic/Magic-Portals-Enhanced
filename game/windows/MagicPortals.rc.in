// The Windows resources of the release MagicPortals.exe (planning step 201, PORT-3), written by magicportals_windows_release in
// game/windows/MagicPortalsWindows.cmake: its version information and, only when the build is given an icon file, that icon.
// The application manifest is NOT here: game/MagicPortals.manifest is a source of the target and the linker merges it.
//
// Beyond looking like a program in Explorer, these matter on a machine running Smart App Control, which judges an unsigned executable by what
// it looks like while it has no reputation, and they are what a signing step will want to find the same in every file it signs.
//
// The version is the CMake project's (CMakeLists.txt, project VERSION): one definition, and the number itself is the owner's to set.
// The words are ASCII on purpose, and say who made this program and whose game it is based on; they claim no right over the original.

#include <winver.h>

@MAGICPORTALS_RC_ICON_LINE@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @MAGICPORTALS_RC_VERSION_COMMAS@
 PRODUCTVERSION @MAGICPORTALS_RC_VERSION_COMMAS@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Ivan Cvetanovic"
            VALUE "FileDescription", "Magic Portals Enhanced"
            VALUE "FileVersion", "@MAGICPORTALS_RC_VERSION@"
            VALUE "InternalName", "@MAGICPORTALS_RC_NAME@"
            VALUE "LegalCopyright", "Enhanced edition by Ivan Cvetanovic. Based on Magic Portals by Asantee Games."
            VALUE "OriginalFilename", "@MAGICPORTALS_RC_NAME@.exe"
            VALUE "ProductName", "Magic Portals Enhanced"
            VALUE "ProductVersion", "@MAGICPORTALS_RC_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
