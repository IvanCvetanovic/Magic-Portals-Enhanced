; Engine configuration file.
; Magic Portals Remake — see ../CLAUDE.md for rules, ../MILESTONE_1.md for scope.
; config_version MUST be 5 for Godot 4.x (4 = Godot 3, loads wrong).

config_version=5

[application]

config/name="Magic Portals Remake"
run/main_scene="res://scenes/main.tscn"
; Target is Godot 4.6 per project spec. NOTE: the editor installed on this machine
; is 4.7.1.stable.steam — it will open this fine and will rewrite this tag to "4.7"
; the first time the project is saved from the editor. See CLAUDE.md → Environment.
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

; EXACTLY THREE (CLAUDE.md rule 3). Do not add a fourth without asking.
; Load order matters and is not alphabetical: DataLoader must be ready before GameState,
; because GameState.load_progress() validates against DataLoader.level_count().
; EventBus is first and depends on nothing — it is signal declarations only.
EventBus="*res://scripts/core/event_bus.gd"
DataLoader="*res://scripts/core/data_loader.gd"
GameState="*res://scripts/core/game_state.gd"

[display]

; ---------------------------------------------------------------------------
; SETTLED 2026-09-14 BY MEASURING THE RUNNING ORIGINAL (MILESTONE_1 §7.4).
;
; The original shows a world 256 units tall. Level 1-1 at 1280x720: floor mortar
; pitch 181/177/182/180/180 px against 64-unit stones = 2.8125 = 720/256. It is
; corroborated by the data (94 of 128 levels place their `max` corner at y=256,
; i.e. exactly one screen tall) and by the art (sky.png is 455x256, one screen).
; This replaces the earlier ~512-tall inference from .esc geometry.
;
; 455x256 + canvas_items + expand is the Godot-native form of that: rendering stays
; at native resolution, 256 units always fill the height, and a wider screen shows
; more world sideways. Height-locked is what one 1184x720 capture of the original
; suggested; only a non-16:9 device can confirm it. Evidence and method:
; docs/ethanon-formats.md, 2026-09-14 block; the rig itself: docs/parity.md.
;
; The window override only sets the desktop window, so a playtest opens at the
; same 1280x720 the parity captures use instead of at 455x256.
; ---------------------------------------------------------------------------
window/size/viewport_width=455
window/size/viewport_height=256
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; Godot 4 stores orientation as an int enum, NOT the Godot-3 string "landscape".
; 0=Landscape, 1=Portrait, 2=Reverse Landscape, 3=Reverse Portrait,
; 4=Sensor Landscape, 5=Sensor Portrait, 6=Sensor.
; (A string here only "works" by to_int() coincidence and silently becomes 0.)
;
; SETTLED 2026-08-04 (was 4 = Sensor Landscape, a placeholder): the original APK's
; AndroidManifest.xml declares android:screenOrientation="0" — LOCKED landscape, not
; sensor. Corroborated by every commented-out resolution pair in app.enml being
; landscape and by 455x256 background art.
window/handheld/orientation=0

[input_devices]

; Keep exactly ONE pointer stream per device so input is never double-processed.
; Desktop = mouse only; Android = touch only. emulate_mouse_from_touch defaults
; to TRUE in Godot and must be disabled, or every touch also fires an emulated
; mouse event on the primary target platform.
pointing/emulate_mouse_from_touch=false
pointing/emulate_touch_from_mouse=false

[rendering]

; Compatibility renderer for the broadest Android device support. Set for both
; the default and the mobile override — the mobile override is what an Android
; export actually uses.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
; ETC2/ASTC compression is required for GLES3-class Android GPUs.
textures/vram_compression/import_etc2_astc=true
